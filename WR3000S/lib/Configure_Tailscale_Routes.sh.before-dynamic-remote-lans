#!/bin/sh

Configure_Tailscale_Routes() {
    if (( INSTALL_TAILSCALE_ROUTES == 0 )); then

        Print_Info \
            "Tailscale subnet-route advertisement skipped."

        return 0
    fi


    (( INSTALL_TAILSCALE == 1 )) ||
        Fail_With_Message \
            "Tailscale subnet-route advertisement was requested, but Tailscale installation is disabled."


    Print_Info \
        "Advertising $LAN_NET through Tailscale..."


    Router_Ssh \
        "tailscale set --advertise-routes=$(Shell_Quote "$LAN_NET")" ||
        Fail_With_Message \
            "Failed to configure Tailscale subnet-route advertisement."


    Print_Success \
        "Tailscale is advertising $LAN_NET."

    # --- Tailscale fw4 / policy-routing additions ---
    uci -q set network.tailscale=interface
    uci -q set network.tailscale.proto='none'
    uci -q set network.tailscale.device='tailscale0'

    TS_ZONE="$(uci show firewall 2>/dev/null | sed -n "s/^firewall\.\(@zone\[[0-9][0-9]*\]\)\.name='tailscale'$/\1/p" | head -n1)"
    if [ -z "$TS_ZONE" ]; then
        TS_ZONE="$(uci add firewall zone)"
    fi

    uci set firewall."$TS_ZONE".name='tailscale'
    uci set firewall."$TS_ZONE".network='tailscale'
    uci set firewall."$TS_ZONE".input='ACCEPT'
    uci set firewall."$TS_ZONE".output='ACCEPT'
    uci set firewall."$TS_ZONE".forward='ACCEPT'
    uci set firewall."$TS_ZONE".masq='1'

    uci -q show firewall | grep -q "src='lan'.*dest='tailscale'" || {
        F="$(uci add firewall forwarding)"
        uci set firewall."$F".src='lan'
        uci set firewall."$F".dest='tailscale'
    }

    uci -q show firewall | grep -q "src='tailscale'.*dest='lan'" || {
        F="$(uci add firewall forwarding)"
        uci set firewall."$F".src='tailscale'
        uci set firewall."$F".dest='lan'
    }

    grep -qxF 'net.ipv4.conf.all.rp_filter=0' /etc/sysctl.conf ||
        echo 'net.ipv4.conf.all.rp_filter=0' >> /etc/sysctl.conf

    grep -qxF 'net.ipv4.conf.tailscale0.rp_filter=0' /etc/sysctl.conf ||
        echo 'net.ipv4.conf.tailscale0.rp_filter=0' >> /etc/sysctl.conf

    sysctl -p

    touch /etc/rc.local
    grep -qF 'nft insert rule inet fw4 output oifname "tailscale0" accept 2>/dev/null' /etc/rc.local || \
        sed -i '/^[[:space:]]*exit 0[[:space:]]*$/i\
nft insert rule inet fw4 output oifname "tailscale0" accept 2>/dev/null
' /etc/rc.local

    uci commit network
    uci commit firewall

    fw4 reload
    /etc/init.d/tailscale restart
    sleep 2

    ip route replace 100.64.0.0/10 dev tailscale0 table 52
    ip route replace 192.168.8.0/24 dev br-lan table 52
    ip route replace 192.168.7.0/24 dev tailscale0 table 52
    ip route replace 192.168.125.0/24 dev tailscale0 table 52 2>/dev/null || true

    ip rule add from 192.168.8.0/24 to 100.64.0.0/10 lookup 52 priority 50 2>/dev/null || true
    ip rule add to 192.168.7.0/24 lookup 52 priority 100 2>/dev/null || true
    ip rule add to 192.168.125.0/24 lookup 52 priority 101 2>/dev/null || true

    ip route flush cache 2>/dev/null || true

    nft insert rule inet fw4 output oifname "tailscale0" accept 2>/dev/null || true

    echo "[Tailscale] Route sanity:"
    ip route get 192.168.7.1 from 192.168.8.1
    ip route get 100.94.58.121 from 192.168.8.1 2>/dev/null || true
}
